{
  "name": "raavl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "examples": "npm run docs:dev",
    "examples:build": "npm run docs:build",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:typecheck": "npm --prefix docs run typecheck",
    "docs:workflows": "node scripts/write-workflows.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build --config vite.library.config.ts && tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build",
    "check:docs": "npm run docs:typecheck && npm --prefix docs run test:skills && npm run docs:build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/library/index.js"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/library/core.js"
    },
    "./dom": {
      "types": "./dist/types/dom/index.d.ts",
      "import": "./dist/library/dom.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/library/react.js"
    },
    "./styles.css": "./src/styles.css",
    "./themes": {
      "types": "./dist/types/themes/index.d.ts",
      "import": "./dist/library/themes.js"
    },
    "./themes.json": "./src/themes/presets.json",
    "./regions": {
      "types": "./dist/types/regions/index.d.ts",
      "import": "./dist/library/regions.js"
    },
    "./timeline": {
      "types": "./dist/types/timeline/index.d.ts",
      "import": "./dist/library/timeline.js"
    },
    "./minimap": {
      "types": "./dist/types/minimap/index.d.ts",
      "import": "./dist/library/minimap.js"
    },
    "./history": {
      "types": "./dist/types/history/index.d.ts",
      "import": "./dist/library/history.js"
    },
    "./snapping": {
      "types": "./dist/types/snapping/index.d.ts",
      "import": "./dist/library/snapping.js"
    }
  },
  "files": [
    "dist/library",
    "dist/types",
    "src/styles.css",
    "src/themes/presets.json",
    "README.md"
  ]
}