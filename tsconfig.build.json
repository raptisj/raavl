{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    "emitDeclarationOnly": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": [
      "react"
    ],
    "inlineSources": true,
    "noEmitOnError": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/styles.d.css.ts"
  ]
}
