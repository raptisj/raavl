{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "raavl": [
        "../dist/index"
      ],
      "raavl/core": [
        "../dist/core/index"
      ],
      "raavl/dom": [
        "../dist/dom/index"
      ],
      "raavl/react": [
        "../dist/react/index"
      ],
      "raavl/themes": [
        "../dist/themes/index"
      ],
      "raavl/themes.json": [
        "../dist/themes/presets.json"
      ],
      "raavl/regions": [
        "../dist/regions/index"
      ],
      "raavl/timeline": [
        "../dist/timeline/index"
      ],
      "raavl/minimap": [
        "../dist/minimap/index"
      ],
      "raavl/history": [
        "../dist/history/index"
      ],
      "raavl/snapping": [
        "../dist/snapping/index"
      ],
      "raavl/package.json": [
        "../package.json"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
