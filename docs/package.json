{
  "name": "raavl-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.22.0" },
  "scripts": {
    "predev": "node scripts/prepare-skills.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "prebuild": "node scripts/prepare-skills.mjs",
    "build": "next build",
    "postbuild": "node scripts/verify-export.mjs",
    "pretypecheck": "node scripts/prepare-skills.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test:skills": "node --test scripts/skills.test.mjs",
    "postinstall": "fumadocs-mdx && node scripts/prepare-skills.mjs"
  },
  "dependencies": {
    "fumadocs-core": "16.18.3",
    "fumadocs-mdx": "15.5.3",
    "fumadocs-ui": "16.18.3",
    "lucide-react": "^1.49.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
