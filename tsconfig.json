{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "raavl": [
        "./src/index.ts"
      ],
      "raavl/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "examples/live",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests/package"
  ]
}
