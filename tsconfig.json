{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "types": ["node", "vitest/globals"]
  },
  "include": ["src", "tests", "examples/live", "vitest.config.ts"]
}
